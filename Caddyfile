{
    email {$CADDY_EMAIL}
}

(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(self), geolocation=()"
        # CSP: scripts only from us (the built bundle has no inline JS); inline
        # styles allowed because the React UI uses style={} attributes; fonts
        # from Google Fonts; images include data: (base64 avatars/.ics); the API
        # is same-origin so connect-src 'self' covers it. MercadoPago is a
        # top-level redirect, so it needs no CSP allowance.
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        -Server
    }
}

# ── Primary domain (Chapni) ───────────────────────────────────────────────────
{$CADDY_APP_DOMAIN:app.chapni.com} {
    encode gzip zstd
    import security_headers

    # Search engines: the app is private, only the booking pages listed here may
    # be indexed. Everything else (/login, /dashboard, /patients…) is the same
    # SPA shell, so leaving it crawlable pollutes the brand's results with
    # duplicates. Add a slug to the matcher to publish another professional.
    @private not path /book/marcela-chapues /book/marcela-chapues/
    header @private X-Robots-Tag "noindex, nofollow"

    # API routes → core-api (never cached)
    handle /api/* {
        header Cache-Control "no-store"
        reverse_proxy core-api:8080
    }

    # API liveness — without this the SPA fallback answers /healthz with
    # index.html and the CI smoke probe passes even with core-api down.
    handle /healthz {
        header Cache-Control "no-store"
        reverse_proxy core-api:8080
    }

    # React SPA — static assets with long-lived cache (filenames are hashed by Vite)
    handle /assets/* {
        root * /srv/frontend
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # All other routes → SPA (React Router handles client-side routing)
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }

    log {
        output stdout
        format json
    }
}

# ── Legacy domain ─────────────────────────────────────────────────────────────
# /api stays alive here: MercadoPago webhooks of pre-migration preapprovals and
# the Google OAuth redirect registered before the move still call this host.
# Everything else (SPA routes, emailed /sign and /reset links) moves over.
{$CADDY_DOMAIN} {
    encode gzip zstd
    import security_headers

    handle /api/* {
        header Cache-Control "no-store"
        reverse_proxy core-api:8080
    }

    handle {
        redir https://{$CADDY_APP_DOMAIN:app.chapni.com}{uri} 308
    }

    log {
        output stdout
        format json
    }
}
